# Settings for the Agent Hub server.
#
# Copy this file to .env next to docker-compose.yml and fill in what you need.
# Every line below is commented out, so a fresh copy sets nothing and every
# default applies. Uncomment a line and give it a value to set it.
#
# ---------------------------------------------------------------------------
# Restart or recreate
# ---------------------------------------------------------------------------
# Which command applies an edit depends on which program reads the variable.
#
# docker compose restart agent_hub
#   Restarts the existing container with the environment it was created with.
#   Only the main server and the resources garbage collector read .env again,
#   because they load /app/.env each time they start. A restart is enough for
#   what only those two read: backend URLs, models and keys,
#   BRAVE_SEARCH_API_KEY, GITHUB_TOKEN, AUTH_TOKEN and CT0, DAV_BASE_URL,
#   CONSOLE_BASE_URL, and the flights and ComfyUI filename variables.
#
# docker compose up -d agent_hub
#   Recreates the container, so every program starts with the new values.
#   It is needed for TZ, SCRATCH_DIR, CHROME_PROFILE_DIR, DATA_DIR and
#   RESOURCES_DIR, which Chrome, its profile setup and docker exec users
#   (the test runner, agent_cli gc) read from the container environment.
#   It is also needed after any edit to docker-compose.yml. Those entries
#   below say "Needs a recreate".
#
# When in doubt, recreate. It applies everything. Neither needs an image
# rebuild.
#
# ---------------------------------------------------------------------------
# How to write a line
# ---------------------------------------------------------------------------
# Docker compose and the shell both read this file, so use the form both read
# the same way: NAME=value, with no "export" and no "$". Put double quotes
# around a value with spaces, as in NAME="two words".
#
# Leave every line you do not use commented out.


# === Part 1: Server settings ===
# The variables the server code reads.

# --- Server and paths ---

# Address the server listens on inside the container.
# Default: 0.0.0.0
# HTTP_HOST=

# Port the server listens on inside the container.
# Default: 80
# Change only together with the "8315:80" port mapping in docker-compose.yml
# and its healthcheck, which connects to port 80. Changing one alone leaves
# the server unreachable or the container marked unhealthy.
# HTTP_PORT=

# Legacy alias of HTTP_HOST, used only when HTTP_HOST is not set.
# Default: 0.0.0.0
# SSE_HOST=

# Legacy alias of HTTP_PORT, used only when HTTP_PORT is not set.
# Default: 80
# SSE_PORT=

# Folder that holds the run records (records.db), run folders and caches.
# Default: /app/data
# Needs a recreate.
# Keep it inside the ./data:/app/data mount in docker-compose.yml. Files
# saved outside a mount are lost when the container is recreated.
# DATA_DIR=

# Folder served over WebDAV at /dav and listed as MCP resources.
# Default: /app/data/resources
# Needs a recreate.
# Keep it inside the ./data:/app/data mount in docker-compose.yml. Files
# saved outside a mount are lost when the container is recreated.
# RESOURCES_DIR=

# Folder that holds the model files.
# Default: /app/models
# Change only together with the ./models:/app/models mount in
# docker-compose.yml and its "environment: MODELS_DIR=/app/models" line,
# which overrides this file for every program except the main server and the
# garbage collector. Changing one alone splits the setting between programs.
#
# Most models download themselves into this folder on first use:
# orientation_model.onnx, OCRerrcr/, yolo11m-seg.pt, and the CLIP and
# CLIPSeg caches. Two do not, and the tools that need them fail until you add
# them by hand:
#   document_classifier.onnx: download onnx/model_quantized.onnx from the
#     Hugging Face repository Mozilla/docornot and save it as
#     <MODELS_DIR>/document_classifier.onnx
#   magika/standard_v3_3/: copy the models/standard_v3_3 folder of the
#     installed magika Python package to <MODELS_DIR>/magika/standard_v3_3
# MODELS_DIR=

# Root of the short lived files, such as Chrome downloads and frames cut
# from videos.
# Default: /dev/shm/agent
# Needs a recreate.
# SCRATCH_DIR=

# Address of this server as seen from outside the container, used to build
# the WebDAV upload and download links.
# Default: http://localhost:8315
# It must be reachable from the MCP clients and from the ComfyUI backend.
# send_or_receive_file, web_fetch downloads and present_to_user hand it to
# clients, and edit_image and generate_video (from an image, or from a first
# and last frame) hand it to ComfyUI to fetch the reference images. The
# default works only when both run on the Docker host. Set it whenever
# ComfyUI or the clients run on another host, or their links do not open and
# edit_image and reference-based generate_video fail inside ComfyUI.
# Example: http://agent.example.com:8315
# DAV_BASE_URL=

# Address of the console, used in the links of research reports.
# Default: same as DAV_BASE_URL
# CONSOLE_BASE_URL=

# --- LLM backends ---
# A URL may be given with or without /v1. Most calls leave out a model or key
# that is not set, so the server picks its default model. research and
# browser_use instead ask for the model "default" and send a placeholder key.

# OpenAI-compatible LLM server for most reasoning.
# Required by google_search, google_flights, web_fetch, read_media_or_doc,
# rednote_research, tts and captcha solving, and by browser_use when
# REASON_THINKING_BACKEND_URL is not set. Those calls fail without it.
# Example: http://llm.example.com:8000/v1
# REASON_BACKEND_URL=

# Model to ask the REASON backend for.
# Default: not set, the server chooses, but browser_use asks for "default"
# REASON_MODEL=

# API key for the REASON backend.
# Default: not set, no key is sent, but browser_use sends a placeholder key
# REASON_API_KEY=

# OpenAI-compatible LLM server with thinking, for the longer tasks.
# Required by research. browser_use prefers it and falls back to
# REASON_BACKEND_URL. Research fails without it.
# Example: http://llm.example.com:8001/v1
# REASON_THINKING_BACKEND_URL=

# Model to ask the REASON_THINKING backend for.
# Default: not set, the server chooses, but research and browser_use ask for
# "default"
# REASON_THINKING_MODEL=

# API key for the REASON_THINKING backend.
# Default: not set, no key is sent, but research and browser_use send a
# placeholder key
# REASON_THINKING_API_KEY=

# --- OCR and ASR ---

# OpenAI-compatible OCR server for document images.
# Required for OCR. Without it, image and PDF reading skip OCR and rely on the
# LLM alone.
# Example: http://ocr.example.com:8000/v1
# OCR_BACKEND_URL=

# Model to ask the OCR backend for.
# Default: not set, the server chooses
# OCR_MODEL=

# API key for the OCR backend.
# Default: not set, no key is sent
# OCR_API_KEY=

# Speech recognition server.
# Required for audio and video transcription in read_media_or_doc and
# web_fetch. Those calls fail without it.
# Example: http://asr.example.com:8000
# ASR_SERVER_URL=

# --- Page check ---

# Laya page classifier, which tells whether a web page fetched without the
# browser is a block page.
# Required to read web pages in web_fetch and read_media_or_doc. Those calls
# fail without it.
# Example: http://localhost:8888
# LAYA_SERVER_URL=

# --- Research ---

# OpenAI-compatible embedding server.
# Required by research, which fails without it.
# Example: http://embedding.example.com:8000/v1
# EMBEDDING_SERVER_URL=

# Model to ask the embedding server for.
# Default: "default"
# EMBEDDING_MODEL=

# API key for the embedding server.
# Default: not set, a placeholder key is sent
# EMBEDDING_API_KEY=

# Reranker server with a /rerank endpoint.
# Required by research, which fails without it.
# Example: http://reranker.example.com:8000/v1
# RERANKER_SERVER_URL=

# Model to ask the reranker for.
# Default: "default"
# RERANKER_MODEL=

# API key for the reranker.
# Default: not set, no key is sent
# RERANKER_API_KEY=

# How many search rounds a research run may take, at least 1.
# Default: 5
# RESEARCH_MAX_ITERATIONS=

# --- TTS ---

# OpenAI-compatible speech server with an /audio/speech endpoint.
# Required by the tts tool and /v1/audio/speech, which fail without it.
# Example: http://tts.example.com:8000/v1
# LOCAL_TTS_URL=

# Voice for English text.
# Required by the tts tool and /v1/audio/speech, which fail without it.
# LOCAL_TTS_VOICE_EN=

# Voice for Chinese text.
# Required by the tts tool and /v1/audio/speech, which fail without it.
# LOCAL_TTS_VOICE_ZH=

# Model to ask the speech server for.
# Default: not set, the model is left out of the request
# Optional, but some servers require it. Set it when yours does, otherwise
# every tts call fails with the server's "Field required" error.
# LOCAL_TTS_MODEL=

# --- ComfyUI ---
# The backend must support the nodes in app/lib/comfyui/workflows.py.
# The model files named below must be in its ComfyUI models folders.

# Base URL of the synchronous SaladTechnologies comfyui-api wrapper.
# The native ComfyUI asynchronous API is incompatible with this client.
# Required by generate_image, edit_image and generate_video, which fail
# without it.
# Example: http://comfyui-api:3000
# COMFYUI_BACKEND_URL=

# Upscale model, used by every workflow with upscale on.
# Default: RealESRGAN_x2plus.pth
# COMFYUI_UPSCALE_MODEL=

# Image diffusion model, used by generate_image and edit_image.
# Default: qwen_image_2.1_int8_convrot.safetensors
# COMFYUI_IMAGE_UNET=

# Image text encoder, used by generate_image and edit_image.
# Default: qwen3vl_8b_w4a8.safetensors
# COMFYUI_IMAGE_CLIP=

# Image VAE, used by generate_image and edit_image.
# Default: qwen_image_2.1_vae_bf16.safetensors
# COMFYUI_IMAGE_VAE=

# Video diffusion model, used by generate_video.
# Default: ltx-2.5-22b-distilled-transformer-nvfp4.safetensors
# COMFYUI_VIDEO_UNET=

# Video text encoder, used by generate_video.
# Default: gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors
# COMFYUI_VIDEO_TEXT_ENCODER=

# Video VAE, used by generate_video.
# Default: ltx-2.5-video-vae-bf16.safetensors
# COMFYUI_VIDEO_VAE=

# Video audio VAE, used by generate_video.
# Default: ltx-2.5-audio-vae-bf16.safetensors
# COMFYUI_VIDEO_AUDIO_VAE=

# --- Credentials ---

# Brave Search API key.
# Required by brave_search, which fails without it.
# BRAVE_SEARCH_API_KEY=

# --- Browser and locale ---

# Chrome DevTools address of the managed browser.
# Default: http://localhost:9222
# Point it only at the Chrome inside this container. A Chrome elsewhere does
# not share this container's folders, so downloads, uploads and thumbnails
# break.
# CHROME_CDP_URL=

# Chrome profile folder, where its download settings are written at start.
# Default: /root/.config/google-chrome-ai
# Needs a recreate.
# Change only together with --user-data-dir in supervisor.conf and the
# ./data/cloakbrowser mount in docker-compose.yml. Changing one alone writes
# the settings into a folder Chrome does not use.
# CHROME_PROFILE_DIR=

# Interface language of google_flights searches.
# Default: en
# GOOGLE_FLIGHTS_LANGUAGE=

# Country of google_flights searches.
# Default: US
# GOOGLE_FLIGHTS_COUNTRY=

# Currency of google_flights prices.
# Default: USD
# GOOGLE_FLIGHTS_CURRENCY=


# === Part 2: Read by other programs ===
# Variables that the server code does not read itself.

# Timezone of the container, an IANA name such as Europe/Berlin.
# Default: UTC
# Read by the C library, and through it by Python and every local time the
# server shows. It also sets the timezone of Chrome's fingerprint.
# Leave the line commented out for UTC. An empty TZ= is UTC too, but
# browser_use's time line then labels it "Universal".
# Needs a recreate.
# TZ=

# GitHub token for the gh command that the github tool runs.
# Default: not set
# Without it, the github tool works only after "gh auth login" inside the
# container, and that login is lost when the container is recreated, because
# /root/.config/gh is not kept. Setting the token is recommended.
# GITHUB_TOKEN=

# X (Twitter) auth_token cookie for the bird command that x_search runs.
# Default: not set
# Set it together with CT0. Without them, bird falls back to reading cookies
# from a browser.
# AUTH_TOKEN=

# X (Twitter) ct0 cookie for the bird command that x_search runs.
# Default: not set
# Set it together with AUTH_TOKEN.
# CT0=


# === Part 3: Host scripts (export in your shell, not read from .env) ===
# Variables that the scripts under scripts/ read on the host. Export them in
# your shell before you run the script. Setting them here has no effect.

# MCP endpoint that scripts/agent_cli talks to.
# Default: http://127.0.0.1:8315/mcp
# MCP_URL=

# Host folder where scripts/console_preview keeps each preview's pid and port.
# Default: /tmp/agent-console-preview
# PREVIEW_STORE_ROOT=
